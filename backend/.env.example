APP_ENV=production
LIVE_TRADING_ENABLED=false
CORS_ORIGINS=*

# auto = Tradier when configured, then Stooq EOD fallback, then Yahoo Finance best effort
MARKET_DATA_PROVIDER=auto
MARKET_DATA_CACHE_SECONDS=60
MARKET_DATA_RETRIES=2
MARKET_DATA_TIMEOUT_SECONDS=12
STOOQ_FALLBACK_ENABLED=true

# Recommended for reliable quotes, history, and option chains.
# Create a Tradier account/token and add the token in Render Environment.
TRADIER_API_TOKEN=
TRADIER_SANDBOX=true
# Leave blank to select sandbox or production automatically.
TRADIER_BASE_URL=

# Social / Whale Intelligence
SOCIAL_INTELLIGENCE_ENABLED=true
# Optional: authorized Invo/export JSON endpoint. The app does not scrape undocumented APIs.
INVO_SOCIAL_API_URL=
INVO_API_TOKEN=
# Optional: comma-separated Hyperliquid public wallet addresses to track.
SOCIAL_HYPERLIQUID_WALLETS=
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz/info
SOCIAL_MIN_CLOSED_TRADES=20
SOCIAL_MIN_WIN_RATE=0.55
SOCIAL_MAX_SCORE_ADJUSTMENT=8
SOCIAL_DATA_CACHE_SECONDS=300

# Verified Strategy Intelligence / AlphaLedger
VERIFIED_STRATEGY_INTELLIGENCE_ENABLED=true
# Authorized/export JSON endpoint only. Do not use an undocumented scraped endpoint.
ALPHALEDGER_API_URL=
ALPHALEDGER_API_TOKEN=
ALPHALEDGER_MIN_ALPHA_SCORE=60
ALPHALEDGER_MIN_SHARPE=0.50
ALPHALEDGER_MAX_DRAWDOWN_PERCENT=40
ALPHALEDGER_MIN_TRACK_RECORD_DAYS=60
ALPHALEDGER_MIN_RELEVANT_STRATEGIES=2
ALPHALEDGER_MAX_SCORE_ADJUSTMENT=6
ALPHALEDGER_DATA_CACHE_SECONDS=300
